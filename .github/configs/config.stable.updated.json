{
  "patches-version": "latest",
  "enable-module-update": true,
  "youtube-morphe": {
    "enabled": true,
    "pkg-name": "com.google.android.youtube",
    "app-name": "youtube",
    "patch-folder": "youtube",
    "rv-brand": "Morphe",
    "build-mode": "both",
    "arch": "arm64-v8a",
    "patches-source": "MorpheApp/morphe-patches",
    "cli-source": "MorpheApp/morphe-desktop",
    "patcher-args": "-e 'Custom branding' -OcustomName='YouTube' -OcustomIcon=assets/youtube/icon -e 'Change header' -Ocustom=assets/youtube/header -e 'Theme' -OdarkThemeBackgroundColor=@android:color/black -OlightThemeBackgroundColor=@android:color/white",
    "uptodown-dlurl": "https://youtube.en.uptodown.com/android",
    "apkmirror-dlurl": "https://apkmirror.com/apk/google-inc/youtube",
    "dpi": "nodpi anydpi",
    "archive-dlurl": "https://archive.org/download/geologically/apks/com.google.android.youtube",
    "github-dlurl": "https://github.com/AzyrRuthless/YTYTM-APK/releases/latest"
  },
  "yt-music-morphe": {
    "enabled": true,
    "pkg-name": "com.google.android.apps.youtube.music",
    "app-name": "youtube-music",
    "patch-folder": "music",
    "rv-brand": "Morphe",
    "build-mode": "both",
    "arch": "arm64-v8a",
    "patches-source": "MorpheApp/morphe-patches",
    "cli-source": "MorpheApp/morphe-desktop",
    "patcher-args": "-e 'Custom branding' -OcustomName='YT Music' -OcustomIcon=assets/yt-music/icon -e 'Theme' -OdarkThemeBackgroundColor=@android:color/black",
    "uptodown-dlurl": "https://youtube-music.en.uptodown.com/android",
    "apkmirror-dlurl": "https://apkmirror.com/apk/google-inc/youtube-music",
    "dpi": "nodpi anydpi",
    "archive-dlurl": "https://archive.org/download/geologically/apks/com.google.android.apps.youtube.music",
    "github-dlurl": "https://github.com/AzyrRuthless/YTYTM-APK/releases/latest"
  },
  "tiktok-morphe": {
    "enabled": true,
    "pkg-name": "com.zhiliaoapp.musically",
    "app-name": "tiktok",
    "patch-folder": "tiktok",
    "rv-brand": "Morphe",
    "build-mode": "both",
    "arch": "arm64-v8a",
    "patches-source": "'icysymmetra/tiktok-patches-for-morphe' 'MorpheApp/morphe-patches'",
    "cli-source": "MorpheApp/morphe-desktop",
    "included-patches": "'Disable Play Store updates'",
    "uptodown-dlurl": "https://tiktok.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/tiktok-pte-ltd/tik-tok-including-musical-ly",
    "dpi": "nodpi anydpi",
    "archive-dlurl": "https://archive.org/download/geologically/apks/com.zhiliaoapp.musically"
  },
  "twitter-piko": {
    "enabled": true,
    "pkg-name": "com.twitter.android",
    "app-name": "twitter",
    "patch-folder": "twitter",
    "rv-brand": "Piko",
    "build-mode": "both",
    "arch": "arm64-v8a",
    "patches-source": "crimera/piko",
    "patches-version": "dev",
    "cli-source": "MorpheApp/morphe-desktop",
    "included-patches": "'Bring back twitter' 'Dynamic color' 'Export all activities'",
    "uptodown-dlurl": "https://twitter.en.uptodown.com/android",
    "apkmirror-dlurl": "https://apkmirror.com/apk/x-corp/twitter",
    "dpi": "nodpi anydpi",
    "archive-dlurl": "https://archive.org/download/geologically/apks/com.twitter.android"
  },
  "instagram-piko": {
    "enabled": true,
    "pkg-name": "com.instagram.android",
    "app-name": "instagram",
    "patch-folder": "instagram",
    "rv-brand": "Piko",
    "build-mode": "both",
    "arch": "arm64-v8a",
    "patches-source": "crimera/piko",
    "patches-version": "dev",
    "cli-source": "MorpheApp/morphe-desktop",
    "excluded-patches": "'Clone'",
    "uptodown-dlurl": "https://instagram.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/instagram/instagram-instagram",
    "dpi": "nodpi anydpi",
    "archive-dlurl": "https://archive.org/download/geologically/apks/com.instagram.android",
    "github-dlurl": "https://github.com/nullcpy/apks/releases/tag/com.instagram.android"
  },
  "gphotos-morphe": {
    "enabled": true,
    "pkg-name": "com.google.android.apps.photos",
    "app-name": "photos",
    "patch-folder": "photos",
    "rv-brand": "Morphe",
    "version": "auto",
    "build-mode": "both",
    "arch": "arm64-v8a",
    "patches-source": "rushiranpise/morphe-patches",
    "cli-source": "MorpheApp/morphe-desktop",
    "patcher-args": "-e 'AMOLED dark theme' -e 'Change package name' -OgooglePhotosPackageName='app.morphe.android.apps.photos' -OgooglePhotosAppName='Photos' -e 'Enable DCIM folders backup control' -e 'Fix DCIM folder classification' -e 'GmsCore support' -e 'Spoof features'",
    "uptodown-dlurl": "https://google-photos.en.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/google-inc/photos",
    "dpi": "nodpi anydpi"
  },
  "gboard-morphe": {
    "enabled": true,
    "pkg-name": "com.google.android.inputmethod.latin",
    "app-name": "gboard",
    "patch-folder": "gboard",
    "rv-brand": "Morphe",
    "version": "auto",
    "build-mode": "both",
    "arch": "arm64-v8a",
    "patches-source": "'jasonwu1994/Gboard-patches' 'MorpheApp/morphe-patches'",
    "cli-source": "MorpheApp/morphe-desktop",
    "excluded-patches": "'Package Rename'",
    "included-patches": "'Disable Play Store updates'",
    "uptodown-dlurl": "https://gboard-go.fr.uptodown.com/android",
    "apkmirror-dlurl": "https://www.apkmirror.com/apk/google-inc/gboard/",
    "dpi": "nodpi anydpi"
  }
}
